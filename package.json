{
  "name": "cistodom-mvp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "prisma:generate": "prisma generate",
    "db:init": "prisma db execute --schema prisma/schema.prisma --file prisma/migrations/000_init/migration.sql",
    "prisma:migrate": "prisma db execute --schema prisma/schema.prisma --file prisma/migrations/000_init/migration.sql",
    "prisma:seed": "tsx prisma/seed.ts",
    "db:reset": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"Remove-Item -LiteralPath prisma/dev.db -Force -ErrorAction SilentlyContinue; npm run db:init; npm run prisma:seed\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "^16.2.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.17.9",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.3.0",
    "eslint-config-next": "^16.2.6",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
